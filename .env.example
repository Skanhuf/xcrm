# XCRM — Production Environment Variables

# База данных
POSTGRES_DB=xcrm
POSTGRES_USER=xcrm
POSTGRES_PASSWORD=тут_придумаешь_сложный_пароль

# JWT секрет (сгенерируй: openssl rand -hex 32)
